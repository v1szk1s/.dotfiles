pc_login() {
  export TOKEN=$(curl --request POST -s \
      --url https://iam.test.cloud.ibm.com/identity/token \
      -H 'content-type: application/x-www-form-urlencoded' \
      -d 'grant_type=urn:ibm:params:oauth:grant-type:apikey' \
      -d apikey="$(cat ~/work/repos/ProviderPortal/.env | grep -e "^APIKey" | cut -d"=" -f 2)" | jq '.access_token' -r)

     if [ -z "$TOKEN" ]; then
       echo "Login failed"
         return 1
     else 
       echo "Login successful"
         return 0
     fi
}
